rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Assumed data model:
    // usuarios: uid, nombre, tipo, mail, estado (client read-only).
    // clientes/proveedores: party/contact fields.
    // productos: description, prices, currencies, type and non-negative stock.
    // compras/ventas/stock: operation header with timestamp and references.
    // ventas may include canal and an internal monthly statistics footprint.
    // detalleVentas snapshots historical cost and fulfillment events.
    // canalesVentas: active catalog plus transactional accumulated statistics.
    // contadores: immutable id plus series/last-number state.
    function autenticado() {
      return request.auth != null;
    }

    function accesoActual() {
      return get(
        /databases/$(database)/documents/accesosUsuarios/$(request.auth.uid)
      ).data;
    }

    function accesoActivoConTipos(tipos) {
      let acceso = accesoActual();
      return acceso.estado == true && acceso.tipo in tipos;
    }

    function usuarioActivo() {
      return autenticado() && accesoActual().estado == true;
    }

    function esRol(tipo) {
      return autenticado() && accesoActivoConTipos([tipo]);
    }

    function puedeGestionarOperaciones() {
      return autenticado() && accesoActivoConTipos(['02', '03', '04']);
    }

    function puedeAdministrarUsuarios() {
      return autenticado() && accesoActivoConTipos(['03', '04']);
    }

    function puedeVerEstadisticas() {
      return autenticado() && accesoActivoConTipos(['03', '04']);
    }

    function esDesarrollador() {
      return esRol('04');
    }

    function accesoCorrespondeAEntidad(tipo) {
      let acceso = accesoActual();
      return acceso.estado == true &&
        acceso.tipo == '01' &&
        acceso.entidadTipo == tipo &&
        acceso.entidadId is string &&
        acceso.entidadId.size() > 0;
    }

    function entidadPropia(tipo) {
      return autenticado() && accesoCorrespondeAEntidad(tipo);
    }

    function validAccess() {
      return request.resource.data.keys().hasAll(['usuarioId', 'tipo', 'estado']) &&
        request.resource.data.keys().hasOnly([
          'usuarioId', 'tipo', 'estado', 'entidadTipo', 'entidadId'
        ]) &&
        request.resource.data.usuarioId is string &&
        request.resource.data.usuarioId.size() > 0 &&
        request.resource.data.usuarioId.size() <= 80 &&
        request.resource.data.tipo in ['01', '02', '03', '04'] &&
        request.resource.data.estado is bool &&
        (
          (request.resource.data.tipo == '01' &&
           request.resource.data.entidadTipo in ['cliente', 'proveedor'] &&
           request.resource.data.entidadId is string &&
           request.resource.data.entidadId.size() > 0 &&
           request.resource.data.entidadId.size() <= 80) ||
          (request.resource.data.tipo != '01' &&
           request.resource.data.get('entidadTipo', null) == null &&
           request.resource.data.get('entidadId', null) == null)
        );
    }

    function validUser() {
      return request.resource.data.keys().hasAll([
        'id', 'uid', 'nombre', 'mail', 'tipo', 'estado'
      ]) &&
        request.resource.data.keys().hasOnly([
          'id', 'uid', 'nombre', 'mail', 'tipo', 'estado',
          'entidadTipo', 'entidadId', 'fecha'
        ]) &&
        request.resource.data.id is string &&
        request.resource.data.uid is string &&
        request.resource.data.nombre is string &&
        request.resource.data.nombre.size() > 0 &&
        request.resource.data.nombre.size() <= 160 &&
        request.resource.data.mail is string &&
        request.resource.data.mail.size() > 0 &&
        request.resource.data.mail.size() <= 254 &&
        request.resource.data.tipo in ['01', '02', '03', '04'] &&
        request.resource.data.estado is bool &&
        (
          (request.resource.data.tipo == '01' &&
           request.resource.data.entidadTipo in ['cliente', 'proveedor'] &&
           request.resource.data.entidadId is string &&
           request.resource.data.entidadId.size() > 0 &&
           request.resource.data.entidadId.size() <= 80) ||
          (request.resource.data.tipo != '01' &&
           request.resource.data.get('entidadTipo', null) == null &&
           request.resource.data.get('entidadId', null) == null)
        ) &&
        validTimestamp('fecha');
    }

    function puedeGestionarRol(tipoAnterior, tipoNuevo) {
      return esDesarrollador() ||
        (esRol('03') && tipoAnterior != '04' && tipoNuevo != '04');
    }

    function usuarioYAccesoSincronizados(usuarioId, uid) {
      let usuario = getAfter(
        /databases/$(database)/documents/usuarios/$(usuarioId)
      ).data;
      let acceso = getAfter(
        /databases/$(database)/documents/accesosUsuarios/$(uid)
      ).data;
      return usuario.uid == uid &&
        acceso.usuarioId == usuarioId &&
        usuario.tipo == acceso.tipo &&
        usuario.estado == acceso.estado &&
        usuario.get('entidadTipo', '') == acceso.get('entidadTipo', '') &&
        usuario.get('entidadId', '') == acceso.get('entidadId', '');
    }

    function validText(field, maxLength) {
      return !(field in request.resource.data) ||
        (request.resource.data[field] is string &&
         request.resource.data[field].size() <= maxLength);
    }

    function validOptionalNumber(field, minValue, maxValue) {
      return !(field in request.resource.data) ||
        request.resource.data[field] == null ||
        (request.resource.data[field] is number &&
         request.resource.data[field] >= minValue &&
         request.resource.data[field] <= maxValue);
    }

    function validLegacyNumberField(field, minValue, maxValue) {
      let previousValue = resource.data.get(field, null);
      let nextValue = request.resource.data.get(field, null);
      return previousValue is string
        ? previousValue.matches('^(0|[1-9][0-9]*)([.][0-9]+)?$') &&
          float(previousValue) >= minValue &&
          float(previousValue) <= maxValue &&
          (
            (nextValue is string && nextValue == previousValue) ||
            (nextValue is number &&
             nextValue >= minValue &&
             nextValue <= maxValue)
          )
        : nextValue == null ||
          (nextValue is number &&
           nextValue >= minValue &&
           nextValue <= maxValue);
    }

    function validTimestamp(field) {
      return !(field in request.resource.data) ||
        request.resource.data[field] is timestamp;
    }

    function validParty() {
      return request.resource.data.keys().hasAll(['nombre']) &&
        request.resource.data.keys().hasOnly([
          'id', 'nombre', 'direccion', 'localidad', 'contacto', 'telefono', 'cuit',
          'razonSocial', 'detalle', 'codArea', 'mail', 'cuentaCorriente', 'fecha'
        ]) &&
        validText('id', 80) && validText('nombre', 160) && validText('direccion', 300) &&
        validText('localidad', 120) && validText('contacto', 160) &&
        validText('telefono', 40) && validText('razonSocial', 200) &&
        validText('detalle', 3000) && validText('codArea', 10) &&
        validText('mail', 254) && validText('cuentaCorriente', 500) &&
        validOptionalNumber('cuit', 0, 999999999999) && validTimestamp('fecha');
    }

    function validProduct() {
      return request.resource.data.keys().hasAll([
          'descripcion', 'monedaCosto', 'monedaPrecio'
        ]) &&
        request.resource.data.keys().hasOnly([
          'id', 'descripcion', 'marca', 'tipo', 'costo', 'precio', 'stock',
          'monedaCosto', 'monedaPrecio', 'imagen', 'fecha', 'pendiente',
          'reservado', 'stockSucursal', 'ediciones'
        ]) &&
        validText('id', 80) && validText('descripcion', 500) && validText('marca', 160) &&
        validText('tipo', 40) && validText('monedaCosto', 20) &&
        validText('monedaPrecio', 20) && validText('imagen', 2000) &&
        (!('monedaCosto' in request.resource.data) ||
          request.resource.data.monedaCosto in ['ARS', 'USD']) &&
        (!('monedaPrecio' in request.resource.data) ||
          request.resource.data.monedaPrecio in ['ARS', 'USD']) &&
        validOptionalNumber('stock', -999999999, 999999999) &&
        validOptionalNumber('pendiente', 0, 999999999) &&
        validOptionalNumber('reservado', 0, 999999999) &&
        (!('stockSucursal' in request.resource.data) ||
          (request.resource.data.stockSucursal is list &&
           request.resource.data.stockSucursal.size() <= 100)) &&
        (!('ediciones' in request.resource.data) ||
          (request.resource.data.ediciones is list &&
           request.resource.data.ediciones.size() <= 1000)) &&
        validTimestamp('fecha');
    }

    function productFieldChanged(field) {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([field]);
    }

    function validChangedProductNumber(field, minValue, maxValue) {
      return !productFieldChanged(field) ||
        (request.resource.data[field] is number &&
         request.resource.data[field] >= minValue &&
         request.resource.data[field] <= maxValue);
    }

    function validChangedProductCurrency(field) {
      return !productFieldChanged(field) ||
        request.resource.data[field] in ['ARS', 'USD'];
    }

    function validChangedProductStockSucursal() {
      return !productFieldChanged('stockSucursal') ||
        (request.resource.data.stockSucursal is list &&
         request.resource.data.stockSucursal.size() <= 100);
    }

    function validOperationProductEdition(entry, field) {
      return entry is map &&
        entry.keys().hasAll([
          'fecha', 'usuario', 'campo', 'valorAnterior', 'valorNuevo'
        ]) &&
        entry.keys().hasOnly([
          'fecha', 'usuario', 'campo', 'valorAnterior', 'valorNuevo'
        ]) &&
        entry.fecha is timestamp &&
        entry.usuario == accesoActual().usuarioId &&
        entry.campo == field &&
        entry.valorAnterior == resource.data.get(field, null) &&
        entry.valorNuevo == request.resource.data[field];
    }

    function validOperationProductEditions(valueField, currencyField) {
      let valueChanged = productFieldChanged(valueField);
      let currencyChanged = productFieldChanged(currencyField);
      let previousEditions = resource.data.get('ediciones', []);
      let nextEditions = request.resource.data.get('ediciones', []);
      let added = (valueChanged ? 1 : 0) + (currencyChanged ? 1 : 0);
      return (
          (!valueChanged && !currencyChanged && !productFieldChanged('ediciones')) ||
          ((valueChanged || currencyChanged) &&
           (!('ediciones' in resource.data) || previousEditions is list) &&
           nextEditions is list &&
           nextEditions.size() <= 1000 &&
           nextEditions.size() == previousEditions.size() + added &&
           nextEditions[0:previousEditions.size()] == previousEditions &&
           ((valueChanged && currencyChanged &&
             validOperationProductEdition(
               nextEditions[nextEditions.size() - 2], valueField
             ) &&
             validOperationProductEdition(
               nextEditions[nextEditions.size() - 1], currencyField
             )) ||
            (valueChanged && !currencyChanged &&
             validOperationProductEdition(
               nextEditions[nextEditions.size() - 1], valueField
             )) ||
            (!valueChanged && currencyChanged &&
             validOperationProductEdition(
               nextEditions[nextEditions.size() - 1], currencyField
             ))))
        );
    }

    function validModernProductUpdate() {
      return validProduct() &&
        validLegacyNumberField('costo', 0, 999999999999) &&
        validLegacyNumberField('precio', 0, 999999999999);
    }

    function validStockProductUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasAny(['stock', 'stockSucursal']) &&
        changed.hasOnly(['stock', 'stockSucursal']) &&
        validChangedProductNumber('stock', -999999999, 999999999) &&
        validChangedProductStockSucursal();
    }

    function validSaleProductUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasAny([
          'reservado', 'precio', 'monedaPrecio', 'stock', 'stockSucursal'
        ]) &&
        changed.hasOnly([
          'reservado', 'precio', 'monedaPrecio', 'ediciones',
          'stock', 'stockSucursal'
        ]) &&
        validChangedProductNumber('reservado', 0, 999999999) &&
        validChangedProductNumber('precio', 0, 999999999999) &&
        validChangedProductCurrency('monedaPrecio') &&
        (!changed.hasAny(['precio', 'monedaPrecio', 'ediciones']) ||
         validOperationProductEditions('precio', 'monedaPrecio'));
    }

    function validPurchaseProductUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasAny([
          'pendiente', 'costo', 'monedaCosto', 'stock', 'stockSucursal'
        ]) &&
        changed.hasOnly([
          'pendiente', 'costo', 'monedaCosto', 'ediciones',
          'stock', 'stockSucursal'
        ]) &&
        validChangedProductNumber('pendiente', 0, 999999999) &&
        validChangedProductNumber('costo', 0, 999999999999) &&
        validChangedProductCurrency('monedaCosto') &&
        (!changed.hasAny(['costo', 'monedaCosto', 'ediciones']) ||
         validOperationProductEditions('costo', 'monedaCosto'));
    }

    function validCommercialProductUpdate() {
      return validSaleProductUpdate() || validPurchaseProductUpdate();
    }

    function preservesProductId() {
      return (
          ('id' in resource.data &&
           'id' in request.resource.data &&
           request.resource.data.id == resource.data.id) ||
          (!('id' in resource.data) && !('id' in request.resource.data))
        );
    }

    function validOperation(referenceField) {
      let data = request.resource.data;
      let estadisticas = data.get('estadisticas', {});
      return data.keys().hasAll(['sucursal', 'monto', 'moneda', 'valorDivisa']) &&
        referenceField in data &&
        data.keys().hasOnly([
          'id', 'sucursal', referenceField, 'monto', 'detalle', 'datalle',
          'fecha', 'estado', 'moneda', 'parcial', 'descuento', 'valorDivisa',
          'valorDolar', 'usuario', 'modificaciones', 'detalleEstado',
          'ediciones', 'canal', 'estadisticas'
        ]) &&
        validText('id', 80) && validText('sucursal', 80) && validText(referenceField, 80) &&
        validText('detalle', 3000) && validText('datalle', 3000) && validText('estado', 40) &&
        validText('moneda', 20) &&
        data.get('estado', 'COMPLETADA') in [
          'PENDIENTE', 'PARCIAL', 'COMPLETADA', 'ANULADA'
        ] &&
        data.get('moneda', 'ARS') in ['ARS', 'USD'] &&
        ((data.moneda == 'ARS' && data.valorDivisa == 1) ||
         (data.moneda == 'USD' && data.valorDivisa > 1)) &&
        validOptionalNumber('monto', 0, 999999999999) &&
        validOptionalNumber('parcial', 0, 999999999999) &&
        validOptionalNumber('descuento', 0, 100) &&
        validOptionalNumber('valorDivisa', 0.000001, 999999999) &&
        validOptionalNumber('valorDolar', 0.000001, 999999999) &&
        validText('usuario', 80) &&
        (!('modificaciones' in data) ||
          (data.modificaciones is list &&
           data.modificaciones.size() <= 1000)) &&
        (!('detalleEstado' in data) ||
          (data.detalleEstado is list &&
           data.detalleEstado.size() <= 1000)) &&
        (!('ediciones' in data) ||
          (data.ediciones is list &&
           data.ediciones.size() <= 1000)) &&
        (!('canal' in data) ||
          (data.canal is string &&
           data.canal.size() > 0 &&
           data.canal.size() <= 40)) &&
        (!('estadisticas' in data) ||
          (estadisticas is map &&
           estadisticas.size() <= 12 &&
           estadisticas.keys().hasAll([
             'version', 'contabilizable', 'canal', 'ventas',
             'totalCostos', 'totalPrecios', 'meses'
           ]) &&
           estadisticas.keys().hasOnly([
             'version', 'contabilizable', 'canal', 'ventas',
             'totalCostos', 'totalPrecios', 'meses', 'mesPrimeraVenta',
             'ultimaVenta'
           ]) &&
           estadisticas.version == 1 &&
           estadisticas.contabilizable is bool &&
           estadisticas.canal is string &&
           estadisticas.canal == data.canal &&
           estadisticas.ventas is int &&
           estadisticas.ventas >= 0 &&
           estadisticas.ventas <= 1 &&
           estadisticas.totalCostos is number &&
           estadisticas.totalCostos >= 0 &&
           estadisticas.totalPrecios is number &&
           estadisticas.totalPrecios >= 0 &&
           estadisticas.meses is map &&
           estadisticas.meses.size() <= 240 &&
           (!('mesPrimeraVenta' in estadisticas) ||
             (estadisticas.mesPrimeraVenta is string &&
              estadisticas.mesPrimeraVenta.matches('^[0-9]{4}-(0[1-9]|1[0-2])$'))) &&
           (!('ultimaVenta' in estadisticas) ||
             estadisticas.ultimaVenta is timestamp))) &&
        validTimestamp('fecha');
    }

    function validNewOperationAudit() {
      let data = request.resource.data;
      let usuarioId = accesoActual().usuarioId;
      let detalleEstado = data.detalleEstado;
      return data.keys().hasAll([
          'usuario', 'modificaciones', 'valorDolar', 'detalleEstado', 'ediciones'
        ]) &&
        data.usuario.matches('^US-[A-Z][0-9]{4}$') &&
        data.usuario == usuarioId &&
        data.modificaciones.size() == 0 &&
        data.ediciones.size() == 0 &&
        detalleEstado.size() == 1 &&
        detalleEstado[0] is map &&
        detalleEstado[0].usuario == usuarioId;
    }

    function preservesOperationAudit() {
      let usuarioId = accesoActual().usuarioId;
      return (
          ('usuario' in resource.data &&
           request.resource.data.usuario == resource.data.usuario) ||
          (!('usuario' in resource.data) &&
           !('usuario' in request.resource.data))
        ) && (
          ('valorDolar' in resource.data &&
           request.resource.data.valorDolar == resource.data.valorDolar) ||
          (!('valorDolar' in resource.data) &&
           !('valorDolar' in request.resource.data))
        ) && (
          ('modificaciones' in resource.data &&
           request.resource.data.modificaciones is list &&
           request.resource.data.modificaciones.size() >= resource.data.modificaciones.size() &&
           request.resource.data.modificaciones.size() <= resource.data.modificaciones.size() + 1 &&
            (request.resource.data.modificaciones.size() == resource.data.modificaciones.size() ||
            request.resource.data.modificaciones[request.resource.data.modificaciones.size() - 1].usuario ==
              usuarioId)) ||
          (!('modificaciones' in resource.data) &&
           !('modificaciones' in request.resource.data))
        );
    }

    function validCanalVentaSeleccionado() {
      return request.resource.data.canal is string &&
        request.resource.data.canal != 'CV-A0000' &&
        exists(/databases/$(database)/documents/canalesVentas/$(request.resource.data.canal)) &&
        getAfter(/databases/$(database)/documents/canalesVentas/$(request.resource.data.canal)).data.estado == true;
    }

    function validStockOperation() {
      return request.resource.data.keys().hasAll(['sucursal']) &&
        request.resource.data.keys().hasOnly([
          'id', 'sucursal', 'detalle', 'fecha', 'tipo', 'usuario',
          'origenTipo', 'origenId'
        ]) &&
        validText('id', 80) && validText('sucursal', 80) && validText('detalle', 3000) &&
        request.resource.data.get('tipo', 'AJUSTE') in [
          'INGRESO', 'EGRESO', 'AJUSTE', 'TRANSFERENCIA', 'REINGRESO'
        ] && validText('usuario', 80) && validText('origenTipo', 80) &&
        validText('origenId', 80) && validTimestamp('fecha');
    }

    function validDetail(parentField) {
      return request.resource.data.keys().hasAll([
        parentField, 'idProducto', 'cantidad', 'precio'
      ]) &&
        request.resource.data.keys().hasOnly([
          parentField, 'id', 'idProducto', 'cantidad', 'precio', 'moneda',
          'descripcion', 'detalle', 'label', 'labelProducto', 'fecha',
          'cantidadCumplida', 'activo', 'ediciones', 'costo', 'monedaCosto',
          'valorDivisaCosto', 'costoEnPesos', 'cumplimientos'
        ]) &&
        validText(parentField, 80) && validText('id', 80) &&
        validText('idProducto', 80) && validText('moneda', 20) &&
        validText('descripcion', 500) && validText('detalle', 1000) &&
        validText('label', 500) && validText('labelProducto', 500) &&
        validOptionalNumber('cantidad', 0.000001, 999999999) &&
        validOptionalNumber('precio', 0, 999999999999) &&
        validOptionalNumber('cantidadCumplida', 0, 999999999) &&
        validOptionalNumber('costo', 0, 999999999999) &&
        validText('monedaCosto', 20) &&
        validOptionalNumber('valorDivisaCosto', 0.000001, 999999999) &&
        validOptionalNumber('costoEnPesos', 0, 999999999999999) &&
        (!('cumplimientos' in request.resource.data) ||
          (request.resource.data.cumplimientos is list &&
           request.resource.data.cumplimientos.size() <= 1000)) &&
        (!('activo' in request.resource.data) || request.resource.data.activo is bool) &&
        (!('ediciones' in request.resource.data) ||
          (request.resource.data.ediciones is list &&
           request.resource.data.ediciones.size() <= 1000)) &&
        validTimestamp('fecha');
    }

    function preservesLegacySaleDetailFields() {
      return (
          ('id' in resource.data && request.resource.data.id == resource.data.id) ||
          (!('id' in resource.data) && !('id' in request.resource.data))
        ) && (
          ('label' in resource.data && request.resource.data.label == resource.data.label) ||
          (!('label' in resource.data) && !('label' in request.resource.data))
        ) && (
          ('labelProducto' in resource.data &&
           request.resource.data.labelProducto == resource.data.labelProducto) ||
          (!('labelProducto' in resource.data) &&
           !('labelProducto' in request.resource.data))
        );
    }

    function validStockDetail() {
      return request.resource.data.keys().hasAll(['stock', 'idProducto', 'stockNuevo']) &&
        request.resource.data.keys().hasOnly([
          'stock', 'idProducto', 'stockNuevo', 'descripcion', 'fecha',
          'cantidad', 'stockAnterior', 'tipo'
        ]) &&
        validText('stock', 80) && validText('idProducto', 80) &&
        validText('descripcion', 500) &&
        validOptionalNumber('stockNuevo', -999999999, 999999999) &&
        validOptionalNumber('stockAnterior', -999999999, 999999999) &&
        validOptionalNumber('cantidad', -999999999, 999999999) &&
        validText('tipo', 40) && validTimestamp('fecha');
    }

    function validSaleDetailSnapshot() {
      return request.resource.data.keys().hasAll([
          'costo', 'monedaCosto', 'valorDivisaCosto',
          'costoEnPesos', 'cumplimientos'
        ]) &&
        request.resource.data.costo is number &&
        request.resource.data.monedaCosto in ['ARS', 'USD'] &&
        request.resource.data.valorDivisaCosto is number &&
        request.resource.data.costoEnPesos is number &&
        ((request.resource.data.monedaCosto == 'ARS' &&
          request.resource.data.valorDivisaCosto == 1 &&
          request.resource.data.costoEnPesos == request.resource.data.costo) ||
         (request.resource.data.monedaCosto == 'USD' &&
          request.resource.data.valorDivisaCosto > 0 &&
          request.resource.data.valorDivisaCosto != 1 &&
          request.resource.data.costoEnPesos > 0)) &&
        request.resource.data.cumplimientos is list;
    }

    match /usuarios/{userId} {
      allow get: if usuarioActivo() &&
        (accesoActual().usuarioId == userId || puedeAdministrarUsuarios());
      allow list: if puedeAdministrarUsuarios() ||
        (usuarioActivo() && resource.data.uid == request.auth.uid);
      allow create: if false;
      allow update: if puedeAdministrarUsuarios() && validUser() &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.uid == resource.data.uid &&
        puedeGestionarRol(resource.data.tipo, request.resource.data.tipo) &&
        usuarioYAccesoSincronizados(userId, request.resource.data.uid);
      allow delete: if false;
    }

    match /accesosUsuarios/{accessId} {
      allow get: if puedeAdministrarUsuarios() ||
        (autenticado() && request.auth.uid == accessId &&
         resource.data.estado == true);
      allow list: if puedeAdministrarUsuarios();
      allow create: if false;
      allow update: if puedeAdministrarUsuarios() && validAccess() &&
        request.resource.data.usuarioId == resource.data.usuarioId &&
        puedeGestionarRol(resource.data.tipo, request.resource.data.tipo) &&
        usuarioYAccesoSincronizados(request.resource.data.usuarioId, accessId);
      allow delete: if false;
    }

    match /{collectionName}/{documentId} {
      allow read: if usuarioActivo() && collectionName in [
        'roles', 'sucursales', 'tipos'
      ];
      allow write: if false;
    }

    match /clientes/{documentId} {
      allow read: if puedeGestionarOperaciones() ||
        (entidadPropia('cliente') &&
         resource.data.id == accesoActual().entidadId);
      allow create: if puedeGestionarOperaciones() && validParty() &&
        (!('id' in request.resource.data) || request.resource.data.id == documentId);
      allow update: if puedeGestionarOperaciones() && validParty() &&
        (!('id' in resource.data) || request.resource.data.id == resource.data.id);
      allow delete: if puedeGestionarOperaciones();
    }

    match /proveedores/{documentId} {
      allow read: if puedeGestionarOperaciones() ||
        (entidadPropia('proveedor') &&
         resource.data.id == accesoActual().entidadId);
      allow create: if puedeGestionarOperaciones() && validParty() &&
        (!('id' in request.resource.data) || request.resource.data.id == documentId);
      allow update: if puedeGestionarOperaciones() && validParty() &&
        (!('id' in resource.data) || request.resource.data.id == resource.data.id);
      allow delete: if puedeGestionarOperaciones();
    }

    match /productos/{documentId} {
      allow read: if usuarioActivo();
      allow create: if puedeGestionarOperaciones() && validProduct() &&
        validOptionalNumber('costo', 0, 999999999999) &&
        validOptionalNumber('precio', 0, 999999999999) &&
        (!('id' in request.resource.data) || request.resource.data.id == documentId);
      allow update: if puedeGestionarOperaciones() &&
        (validModernProductUpdate() ||
         validStockProductUpdate() ||
         validCommercialProductUpdate()) &&
        preservesProductId();
      allow delete: if puedeGestionarOperaciones();
    }

    match /compras/{documentId} {
      allow read: if puedeGestionarOperaciones() ||
        (entidadPropia('proveedor') &&
         resource.data.proveedor == accesoActual().entidadId);
      allow create: if puedeGestionarOperaciones() && validOperation('proveedor') &&
        validNewOperationAudit() &&
        !('canal' in request.resource.data) &&
        !('estadisticas' in request.resource.data) &&
        (!('id' in request.resource.data) || request.resource.data.id == documentId);
      allow update: if puedeGestionarOperaciones() && validOperation('proveedor') &&
        preservesOperationAudit() &&
        !('canal' in request.resource.data) &&
        !('estadisticas' in request.resource.data) &&
        (!('id' in resource.data) || request.resource.data.id == resource.data.id);
      allow delete: if false;
    }

    match /ventas/{documentId} {
      allow read: if puedeGestionarOperaciones() ||
        (entidadPropia('cliente') &&
         resource.data.cliente == accesoActual().entidadId);
      allow create: if puedeGestionarOperaciones() && validOperation('cliente') &&
        validNewOperationAudit() &&
        ('estadisticas' in request.resource.data) &&
        request.resource.data.estadisticas.contabilizable == true &&
        validCanalVentaSeleccionado() &&
        (!('id' in request.resource.data) || request.resource.data.id == documentId);
      allow update: if puedeGestionarOperaciones() && validOperation('cliente') &&
        preservesOperationAudit() &&
        (!('estadisticas' in resource.data) ||
         ('estadisticas' in request.resource.data &&
          request.resource.data.estadisticas.contabilizable == true)) &&
        (validCanalVentaSeleccionado() ||
         (!('canal' in resource.data) && !('canal' in request.resource.data))) &&
        (!(resource.data.get('estadisticas', {}).get('ventas', 0) > 0) ||
         (request.resource.data.moneda == resource.data.get('moneda', 'ARS') &&
          request.resource.data.valorDivisa == resource.data.get('valorDivisa', 1))) &&
        (!('id' in resource.data) || request.resource.data.id == resource.data.id);
      allow delete: if false;
    }

    match /stock/{documentId} {
      allow read: if puedeGestionarOperaciones();
      allow create: if puedeGestionarOperaciones() && validStockOperation() &&
        (!('id' in request.resource.data) || request.resource.data.id == documentId);
      allow update: if puedeGestionarOperaciones() && validStockOperation() &&
        (!('id' in resource.data) || request.resource.data.id == resource.data.id);
      allow delete: if false;
    }

    match /detalleCompras/{documentId} {
      allow read: if puedeGestionarOperaciones() ||
        (entidadPropia('proveedor') &&
         get(/databases/$(database)/documents/compras/$(resource.data.compra))
           .data.proveedor == accesoActual().entidadId);
      allow create: if puedeGestionarOperaciones() && validDetail('compra') &&
        !request.resource.data.keys().hasAny(['id', 'label', 'labelProducto']) &&
        !request.resource.data.keys().hasAny([
          'costo', 'monedaCosto', 'valorDivisaCosto',
          'costoEnPesos', 'cumplimientos'
        ]);
      allow update: if puedeGestionarOperaciones() && validDetail('compra') &&
        !request.resource.data.keys().hasAny(['id', 'label', 'labelProducto']) &&
        !request.resource.data.keys().hasAny([
          'costo', 'monedaCosto', 'valorDivisaCosto',
          'costoEnPesos', 'cumplimientos'
        ]) &&
        request.resource.data.compra == resource.data.compra;
      allow delete: if false;
    }

    match /detalleVentas/{documentId} {
      allow read: if puedeGestionarOperaciones() ||
        (entidadPropia('cliente') &&
         get(/databases/$(database)/documents/ventas/$(resource.data.venta))
           .data.cliente == accesoActual().entidadId);
      allow create: if puedeGestionarOperaciones() && validDetail('venta') &&
        !request.resource.data.keys().hasAny(['id', 'label', 'labelProducto']) &&
        validSaleDetailSnapshot();
      allow update: if puedeGestionarOperaciones() && validDetail('venta') &&
        preservesLegacySaleDetailFields() &&
        (validSaleDetailSnapshot() ||
         (!resource.data.keys().hasAny([
            'costo', 'monedaCosto', 'valorDivisaCosto',
            'costoEnPesos', 'cumplimientos'
          ]) &&
          !request.resource.data.keys().hasAny([
            'costo', 'monedaCosto', 'valorDivisaCosto',
            'costoEnPesos', 'cumplimientos'
          ]))) &&
        (!resource.data.keys().hasAny([
           'costo', 'monedaCosto', 'valorDivisaCosto', 'costoEnPesos'
         ]) ||
         (request.resource.data.costo == resource.data.costo &&
          request.resource.data.monedaCosto == resource.data.monedaCosto &&
          request.resource.data.valorDivisaCosto == resource.data.valorDivisaCosto &&
          request.resource.data.costoEnPesos == resource.data.costoEnPesos)) &&
        request.resource.data.venta == resource.data.venta;
      allow delete: if false;
    }

    match /detalleStock/{documentId} {
      allow read: if puedeGestionarOperaciones();
      allow create: if puedeGestionarOperaciones() && validStockDetail();
      allow update: if false;
      allow delete: if false;
    }

    match /contadores/{counterId} {
      allow read: if puedeGestionarOperaciones() || puedeAdministrarUsuarios();
      allow create, delete: if false;
      allow update: if
        counterId != 'usuarios' && puedeGestionarOperaciones() &&
        request.resource.data.keys().hasOnly(['id', 'serie', 'ultimo']) &&
        validText('id', 80) &&
        (!('id' in resource.data) || request.resource.data.id == resource.data.id) &&
        request.resource.data.serie is string &&
        request.resource.data.serie.matches('^[A-Z]{1,10}$') &&
        request.resource.data.ultimo is int &&
        request.resource.data.ultimo >= 0 &&
        request.resource.data.ultimo <= 99999999 &&
        (
          (request.resource.data.serie == resource.data.get('serie', 'A') &&
           request.resource.data.ultimo >= resource.data.ultimo &&
           request.resource.data.ultimo <= resource.data.ultimo + 500) ||
          (request.resource.data.serie != resource.data.get('serie', 'A') &&
           request.resource.data.ultimo >= 1 &&
           request.resource.data.ultimo <= 500)
        ) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['serie', 'ultimo']);
    }

    function validCanalVenta(documentId) {
      return request.resource.data.keys().hasAll(['id', 'nombre', 'estado']) &&
        request.resource.data.keys().hasOnly([
          'id', 'nombre', 'estado', 'ventas', 'totalCostos', 'totalPrecios',
          'totalGanancia', 'ultimaVenta', 'meses'
        ]) &&
        request.resource.data.id == documentId &&
        request.resource.data.id is string &&
        request.resource.data.id.matches('^CV-A[0-9]{4}$') &&
        request.resource.data.nombre is string &&
        request.resource.data.nombre.size() > 0 &&
        request.resource.data.nombre.size() <= 160 &&
        request.resource.data.estado is bool &&
        validOptionalNumber('ventas', 0, 999999999) &&
        validOptionalNumber('totalCostos', 0, 999999999999999) &&
        validOptionalNumber('totalPrecios', 0, 999999999999999) &&
        (!('totalGanancia' in request.resource.data) ||
          request.resource.data.totalGanancia is number) &&
        validTimestamp('ultimaVenta') &&
        (!('meses' in request.resource.data) ||
          (request.resource.data.meses is map &&
           request.resource.data.meses.size() <= 240));
    }

    match /canalesVentas/{documentId} {
      allow get: if puedeVerEstadisticas() ||
        (esRol('02') && documentId == 'CV-A0000') ||
        (esRol('02') && documentId != 'CV-A0000' && resource.data.estado == true);
      allow list: if puedeVerEstadisticas() ||
        (esRol('02') && resource.data.id != 'CV-A0000' &&
         resource.data.estado == true);
      allow create, delete: if false;
      allow update: if puedeGestionarOperaciones() && validCanalVenta(documentId) &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.nombre == resource.data.nombre &&
        request.resource.data.estado == resource.data.estado &&
        (
          (documentId == 'CV-A0000' &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['meses'])) ||
          (documentId != 'CV-A0000' &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'ventas', 'totalCostos', 'totalPrecios', 'ultimaVenta'
           ]))
        );
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
